#!/bin/sh

/usr/bin/clear
echo "Current directory:" `pwd`
echo "Current host     :" `hostname`
echo ""

if [ -f AMaLGaM-Full ]
then
  rm AMaLGaM-Full
fi

echo -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
g++ -g -w -pipe -Wall -W -O2 -DNO_DEBUG -o AMaLGaM-Full AMaLGaM-Full.c
echo -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-

if [ -f AMaLGaM-Full.exe ]
then
  mv AMaLGaM-Full.exe AMaLGaM-Full
fi
